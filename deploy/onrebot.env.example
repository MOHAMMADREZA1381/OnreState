# Copy to /etc/onrebot.env on the server (chmod 600) and fill in the real values.
# Never commit the real file.

# Required: token from BotFather
BOT_TOKEN=put-your-bot-token-here

# Optional: numeric Telegram id of the admin (only this user can use /stats). 0 disables /stats.
ADMIN_USER_ID=0

# Optional: free API key from https://developer.titan.exchange. Adds Titan to the swap prices. Leave it out to show Jupiter only.
# TITAN_API_KEY=put-your-titan-key-here

# Optional but recommended: a private Solana RPC (Helius, QuickNode, ...). Faster and without rate limits.
# SOLANA_RPC_URL=https://your-private-rpc-url
